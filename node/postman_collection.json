{
  "info": {
    "name": "API SII",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "REEMPLAZAR_API_KEY",
      "type": "string"
    },
    {
      "key": "lote_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health",
        "description": "Verifica que el servidor esté corriendo. No requiere autenticación."
      }
    },
    {
      "name": "Estado F29",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/getEstadoF29",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rut\": \"REEMPLAZAR_RUT\",\n  \"pass\": \"REEMPLAZAR_PASS\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Obtiene el estado del Formulario 29 (IVA). Las credenciales van en el body."
      }
    },
    {
      "name": "Declaración F29 — Por Mes",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rut\": \"REEMPLAZAR_RUT\",\n  \"pass\": \"REEMPLAZAR_CLAVE_SII\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/F29/declaracion/09/2026",
        "description": "Estado de la declaración F29 de un período: si está declarada (estado, monto, folio, fecha) y la base de ventas netas para PPM. Un login por consulta."
      }
    },
    {
      "name": "Detalle F29 por código — Por Mes",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rut\": \"REEMPLAZAR_RUT\",\n  \"pass\": \"REEMPLAZAR_CLAVE_SII\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/F29/detalle/09/2026",
        "description": "Todos los códigos de la declaración F29 vigente del período (montos enteros), folio, fecha, tipo (original/rectificatoria) e historial, más el formulario compacto en PDF como evidencia (archivo.base64 + sha256). 404 si el período no tiene declaración vigente. Nunca rectifica."
      }
    },
    {
      "name": "Detalle F22 por código — Año tributario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rut\": \"REEMPLAZAR_RUT\",\n  \"pass\": \"REEMPLAZAR_CLAVE_SII\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/F22/detalle/2026",
        "description": "Todos los códigos del F22 vigente del año tributario (montos enteros en codigos; campos de texto en codigosTexto) y su folio. 404 si no hay F22 vigente. Nunca rectifica."
      }
    },
    {
      "name": "Estado F22 — Año tributario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rut\": \"REEMPLAZAR_RUT\",\n  \"pass\": \"REEMPLAZAR_CLAVE_SII\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/F22/estado/2026",
        "description": "Estado del F22 de un año tributario: folio vigente, historial de eventos del SII y lista de observaciones vigentes (vacía si no hay). 404 si no hay F22 vigente."
      }
    },
    {
      "name": "Estado declaraciones juradas — Año tributario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rut\": \"REEMPLAZAR_RUT\",\n  \"pass\": \"REEMPLAZAR_CLAVE_SII\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/DDJJ/estado/2026",
        "description": "Declaraciones juradas anuales presentadas en el año tributario: formulario, folio, fecha, estado (Aceptada, etc.), tipo y medio de presentación."
      }
    },
    {
      "name": "Detalle de una declaración jurada propia — Año tributario y DJ",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rut\": \"REEMPLAZAR_RUT\",\n  \"pass\": \"REEMPLAZAR_CLAVE_SII\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/DDJJ/detalle/2026/1947",
        "description": "Contenido de una DJ que el propio contribuyente presentó (p. ej. 1947, 1887, 1879): por cada presentación, resumen y detalle por sección como tablas crudas del SII (una por página), observaciones e historial. 404 si la DJ no se presentó ese año tributario."
      }
    },
    {
      "name": "Catálogo de códigos F22 — Año tributario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": "{{base_url}}/api/F22/catalogo/2026",
        "description": "Códigos del F22 del año tributario con su glosa oficial (codigo, descripcion, descripcionCorta, tipoDato, tipoCodigo). No requiere credenciales del SII: es un archivo público del SII. 404 si el SII aún no publica ese AT."
      }
    },
    {
      "name": "Información de terceros — Año tributario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rut\": \"REEMPLAZAR_RUT\",\n  \"pass\": \"REEMPLAZAR_CLAVE_SII\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/terceros/2026",
        "description": "Lo que terceros (empleadores, bancos, AFP, sociedades) informaron del contribuyente en sus DDJJ. Devuelve por cada DJ el resumen y el detalle por sección (detalle: [{ seccion, tabla, cantRegistros, paginas: [tabla…] }]) como tablas crudas del SII. Pensado para personas naturales; una empresa suele responder vacío."
      }
    },
    {
      "name": "Boletas honorarios recibidas — Informe anual",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rut\": \"REEMPLAZAR_RUT\",\n  \"pass\": \"REEMPLAZAR_CLAVE_SII\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/boletas/recibidas-anual/2026",
        "description": "Resumen de los 12 meses de boletas de honorarios electrónicas recibidas en una sola consulta (vigentes, anuladas, honorario bruto, retenciones y líquido) más los totales del año."
      }
    },
    {
      "name": "Lote — Crear",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rut\": \"REEMPLAZAR_RUT\",\n  \"pass\": \"REEMPLAZAR_CLAVE_SII\",\n  \"items\": [\n    { \"tipo\": \"f29_detalle\", \"mes\": 9, \"anio\": 2026 },\n    { \"tipo\": \"rcv_ventas\", \"mes\": 9, \"anio\": 2026, \"detallado\": true },\n    { \"tipo\": \"rcv_compras\", \"mes\": 9, \"anio\": 2026, \"detallado\": false },\n    { \"tipo\": \"bhe_recibidas\", \"mes\": 9, \"anio\": 2026 },\n    { \"tipo\": \"f22_detalle\", \"anio\": 2026 },\n    { \"tipo\": \"f22_estado\", \"anio\": 2026 },\n    { \"tipo\": \"ddjj_estado\", \"anio\": 2026 },\n    { \"tipo\": \"ddjj_detalle\", \"anio\": 2026, \"dj\": 1947 },\n    { \"tipo\": \"bhe_anual\", \"anio\": 2026 }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/lotes",
        "description": "Inicia un lote asíncrono: UNA sesión SII para varias descargas (máx. 50). Tipos mensuales (mes y anio): f29_detalle, rcv_compras, rcv_ventas, bhe_recibidas. Tipos anuales (solo anio = año tributario o año del informe): f22_detalle, f22_estado, ddjj_estado, ddjj_detalle (además requiere dj, p. ej. 1947), bhe_anual, terceros. Responde 202 con el id; consulte el avance con \"Lote — Consultar\". Mientras corre, cualquier otra consulta del mismo RUT recibe 409."
      }
    },
    {
      "name": "Lote — Consultar",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": "{{base_url}}/api/v1/lotes/{{lote_id}}",
        "description": "Estado y resultados de un lote: en_cola, procesando, terminado o error. Los resultados se conservan 1 hora en memoria. Pegue el id de \"Lote — Crear\" en la variable lote_id."
      }
    },
    {
      "name": "RCV Compras — Por Mes",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/RCV/compras/04/2025",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Obtiene compras del mes. Credenciales tomadas de SII_RUT / SII_PASS en .env. Parámetros en la URL: /compras/{mes}/{año}"
      }
    },
    {
      "name": "RCV Ventas — Por Mes",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/RCV/ventas/04/2025",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Obtiene ventas del mes. Parámetros en la URL: /ventas/{mes}/{año}"
      }
    },
    {
      "name": "Boletas Honorarios Recibidas — Por Mes",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/boletas/recibidas/04/2025",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rut\": \"REEMPLAZAR_RUT\",\n  \"pass\": \"REEMPLAZAR_PASS\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Informe mensual de boletas de honorarios RECIBIDAS por el RUT indicado. Parámetros en la URL: /recibidas/{mes}/{año}. Credenciales van en el body."
      }
    },
    {
      "name": "[Error] Sin API Key",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health",
        "description": "Prueba que el health check NO requiere API key."
      }
    },
    {
      "name": "[Error] API Key inválida",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/getEstadoF29",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Api-Key",
            "value": "clave_incorrecta"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rut\": \"12345678-9\",\n  \"pass\": \"test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Debe retornar 401."
      }
    },
    {
      "name": "[Error] Mes inválido",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/RCV/compras/13/2025",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Mes 13 es inválido. Debe retornar 400."
      }
    },
    {
      "name": "[Error] Año inválido",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/RCV/compras/04/25",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Año '25' es inválido (debe tener 4 dígitos). Debe retornar 400."
      }
    }
  ]
}
